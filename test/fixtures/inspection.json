      "source": {
        "path": "src/lib/components/SystemStatus.svelte",
        "text": "<script lang=\"ts\">\n  import { onMount } from 'svelte'\n  import { i18n } from '$lib/i18n'\n  import { api } from '$lib/api'\n  import type { Health } from '$lib/types'\n\n  let health = $state<Health>({\n    status: 'ok',\n    service: 'web',\n    database: 'ok',\n    uptimeSeconds: 1234,\n    latencyMs: 12,\n  })\n\n  let error = $state<string | null>(null)\n\n  const tone = $derived(health.status === 'ok' ? 'ok' : 'down')\n  const label = $derived(tone === 'ok' ? 'All systems online' : 'Degraded')\n\n  async function refresh() {\n    try {\n      health = await api.health()\n      error = null\n    } catch (cause) {\n      error = cause instanceof Error ? cause.message : String(cause)\n    }\n  }\n\n  onMount(() => {\n    void refresh()\n    const timer = window.setInterval(() => void refresh(), 30_000)\n    return () => window.clearInterval(timer)\n  })\n</script>\n\n<!-- Quiet by design: a dot, a label, and a live region. -->\n<div class=\"connection-pill\" aria-live=\"polite\" title={i18n.t('status.liveTitle')}>\n  <span class=\"dot {tone}\" aria-hidden=\"true\"></span>\n  <span>{label}</span>\n</div>\n\n<style>\n  .connection-pill {\n    display: inline-flex;\n    gap: 6px;\n    align-items: center;\n  }\n  .dot.ok {\n    background: #22c55e;\n  }\n  .dot.down {\n    background: #ef4444;\n  }\n</style>\n"
      }
    },
