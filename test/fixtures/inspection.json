        "path": "src/routes/dashboard/+page.svelte",
        "text": "<script lang=\"ts\">\n  import Icon from '$lib/components/Icon.svelte'\n  import { i18n } from '$lib/i18n'\n\n  let { data } = $props()\n\n  const firstName = $derived(data.user.name.split(' ')[0])\n  const greeting = $derived(i18n.t('dashboard.ready'))\n</script>\n\n<main class=\"app-main\">\n  <section class=\"home-greeting\">\n    <div>\n      <p class=\"eyebrow\">{i18n.t('dashboard.eyebrow')}</p>\n      <h1>{i18n.t('dashboard.welcome', { name: firstName })}</h1>\n      <p>{greeting}</p>\n    </div>\n\n    <!-- The actions wrap together on narrow screens. -->\n    <div class=\"page-actions\">\n      <a class=\"button button-quiet\" href=\"/files\">\n        <Icon name=\"folder\" />\n        {i18n.t('dashboard.openSpace')}\n      </a>\n      <a class=\"button\" href=\"/agent\">{i18n.t('dashboard.openChat')}</a>\n    </div>\n  </section>\n</main>\n"
