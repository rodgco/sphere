{
  "name": "sphere-plugin",
  "version": "0.3.0",
  "description": "Dev-only Vite plugin that turns a picked Svelte element into a precise markdown prompt for a coding agent.",
  "keywords": [
    "devtools",
    "prompt",
    "svelte",
    "sveltekit",
    "vite-plugin"
  ],
  "homepage": "https://github.com/rodgco/sphere#readme",
  "bugs": {
    "url": "https://github.com/rodgco/sphere/issues"
  },
  "license": "MIT",
  "author": "Rodrigo Couto <r@rodg.co>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodgco/sphere.git"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "vite --config fixtures/plain/vite.config.ts",
    "lab": "vite --config fixtures/lab/vite.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src test",
    "prepublishOnly": "npm run check",
    "test": "npm run build && npm run test:unit && npm run test:harness",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:svelte",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test",
    "typecheck:svelte": "svelte-check --threshold error",
    "e2e": "node e2e/picking.mjs && node e2e/clipboard.mjs && node e2e/location.mjs && node e2e/keyboard.mjs && node e2e/base-path.mjs && node e2e/a11y.mjs && node e2e/panel.mjs && node e2e/theme.mjs",
    "e2e:a11y": "node e2e/a11y.mjs",
    "e2e:picking": "node e2e/picking.mjs",
    "golden": "node scripts/golden.mjs",
    "video": "node scripts/video/sphere.mjs",
    "docs:example": "node scripts/clipboard-example.mjs",
    "lab:shots": "node scripts/lab/shots.mjs",
    "check:generated": "npm run golden && npm run docs:example && git diff --exit-code test/golden/prompt.md docs/specs/clipboard-example.md",
    "e2e:clipboard": "node e2e/clipboard.mjs",
    "e2e:location": "node e2e/location.mjs",
    "e2e:base-path": "node e2e/base-path.mjs",
    "pkg:check": "npm run build && publint && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "e2e:keyboard": "node e2e/keyboard.mjs",
    "e2e:panel": "node e2e/panel.mjs",
    "e2e:theme": "node e2e/theme.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "playwright": "^1.65.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
