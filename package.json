{
  "name": "sphere-plugin",
  "version": "0.0.0",
  "description": "Dev-only Vite plugin that turns a picked Svelte element into a precise markdown prompt for a coding agent.",
  "keywords": [
    "devtools",
    "prompt",
    "svelte",
    "sveltekit",
    "vite-plugin"
  ],
  "homepage": "https://github.com/rodgco/sphere#readme",
  "bugs": {
    "url": "https://github.com/rodgco/sphere/issues"
  },
  "license": "MIT",
  "author": "Rodrigo Couto <r@rodg.co>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodgco/sphere.git"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "vite --config fixtures/plain/vite.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src test",
    "prepublishOnly": "npm run check",
    "test": "npm run test:unit && npm run test:harness",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
