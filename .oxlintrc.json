{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["__svelte_meta", "__SPHERE__"] }]
  },
  "ignorePatterns": ["dist/**", "coverage/**", "fixtures/**/dist/**", "test/harness/generated/**"]
}
